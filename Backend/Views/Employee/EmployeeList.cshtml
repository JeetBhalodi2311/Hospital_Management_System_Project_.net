@model System.Data.DataTable
@using System.Data

@{
    ViewData["Title"] = "Employee List";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    table th, table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .table-hover tbody tr:hover {
        background-color: #f3f7ff;
    }

    .badge-status {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 10px;
        font-weight: 600;
    }

    .active-yes {
        background-color: #d4edda;
        color: #155724;
    }

    .active-no {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>

<!-- Breadcrumb and Title Section -->
<div class="container mt-4">
    <h4 class="fw-bold text-primary">
        <i class="bi bi-people-fill me-2"></i>Employee List
    </h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light px-3 py-2 rounded shadow-sm">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none text-dark">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Employee/EmployeeAddEdit" class="text-decoration-none text-dark">Employee Add/Edit</a></li>
            <li class="breadcrumb-item active text-primary" aria-current="page">Employee List</li>
        </ol>
    </nav>
</div>

<!-- Search and Add Button -->
<div class="d-flex justify-content-between mb-3 align-items-center">
    <div class="me-3" style="flex-grow: 1; max-width: 300px;">
        <input type="text" id="searchInput" class="form-control shadow-sm" placeholder="Search employees..." />
    </div>
    <a href="/Employee/EmployeeAddEdit" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Employee
    </a>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Employee Table -->
<div class="table-responsive shadow-sm rounded" style="max-height: 70vh; overflow-y: auto;">
    <table id="employeeTable" class="table table-hover table-bordered align-middle">
        <thead class="table-primary text-center">
            <tr>
                <th>Employee ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Gender</th>
                <th>Hire Date</th>
                <th>Job Title</th>
                <th>Department</th>
                <th>Salary</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                var isActive = Convert.ToBoolean(row["IsActive"]);
                var badgeClass = isActive ? "badge-status active-yes" : "badge-status active-no";
                var fullName = $"{row["FirstName"]} {row["LastName"]}";
                var salary = row["Salary"] != DBNull.Value ? Convert.ToDecimal(row["Salary"]).ToString("C") : "-";

                <tr>
                    <td class="text-center">@row["EmployeeId"]</td>
                    <td>@fullName</td>
                    <td>@row["Email"]</td>
                    <td>@row["PhoneNumber"]</td>
                    <td>@row["Gender"]</td>
                    <td>@Convert.ToDateTime(row["HireDate"]).ToString("yyyy-MM-dd")</td>
                    <td>@row["JobTitle"]</td>
                    <td>@row["Department"]</td>
                    <td class="text-end">@salary</td>
                    <td class="text-center">
                        <span class="@badgeClass">@(isActive ? "Yes" : "No")</span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="@Url.Action("EmployeeAddEdit", "Employee", new { EmployeeId = row["EmployeeId"] })" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="EmployeeDelete" asp-route-EmployeeId="@row["EmployeeId"]" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure to delete this employee?');">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Search Script -->
<script>
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let input = this.value.toLowerCase();
        let rows = document.querySelectorAll("#employeeTable tbody tr");

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    });
</script>
