                <tr id="noRecord" style="display: none;">
                    <td colspan="8" class="text-center text-danger fw-bold">No Record Found!!</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Search Script -->

<script>
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let input = this.value.toLowerCase();
        let rows = document.querySelectorAll("#userTable tbody tr");
        let matchFound = false;

        rows.forEach(row => {
            if (row.id === "noRecord") return;

            let text = row.innerText.toLowerCase();
            let isMatch = text.includes(input);
            row.style.display = isMatch ? "" : "none";

            if (isMatch) matchFound = true;
        });

        document.getElementById("noRecord").style.display = matchFound ? "none" : "";
    });
</script> *@



















@model DataTable
@using System.Data
@using Hospital_Management_System.Helpers
@{
    ViewData["Title"] = "User List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    table th, table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .table-hover tbody tr:hover {
        background-color: #f3f7ff;
    }

    thead input {
        width: 100%;
        box-sizing: border-box;
    }
</style>

<!-- Breadcrumb and Title -->
<div class="container mt-4">
    <h4 class="fw-bold text-primary"><i class="bi bi-people-fill me-2"></i>User List</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light px-3 py-2 rounded shadow-sm">
            <li class="breadcrumb-item"><a href="/Dashboard/Index" class="text-decoration-none text-dark">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/User/UserAddEdit" class="text-decoration-none text-dark">User Add/Edit</a></li>
            <li class="breadcrumb-item active text-primary" aria-current="page">User List</li>
        </ol>
    </nav>
</div>

<!-- Search & Add Button -->
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3 align-items-center flex-wrap">

        <div class="d-flex gap-2 mb-2">
            <!-- Export Dropdown -->
            <div class="dropdown">
                <button class="btn btn-outline-primary shadow-sm dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                    <li>
                        <a class="dropdown-item" href="/User/ExportToExcel">
                            <i class="bi bi-file-earmark-excel me-1 text-success"></i> Excel
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/User/ExportToPDF">
                            <i class="bi bi-file-earmark-pdf me-1 text-danger"></i> PDF
                        </a>
                    </li>
                </ul>
            </div>

            <a href="/User/UserAddEdit" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add User
            </a>
            <a href="/User/DeleteAll" class="btn btn-danger shadow-sm"
               onclick="return confirm('Are you sure you want to delete ALL records?');">
                <i class="bi bi-trash3-fill me-1"></i> Delete All
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Section -->
    <div class="table-responsive shadow-sm rounded" style="max-height: 70vh; overflow-y: auto;">
        <table class="table table-hover table-bordered align-middle" id="userTable">
            <thead class="table-primary text-center">
                <tr>
                    <th>Username</th>
                    <th>Password</th>
                    <th>Email</th>
                    <th>Mobile No</th>
                    <th>Is Active</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>Action</th>
                </tr>
                <!-- Search row -->
                <tr class="bg-light">
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Username"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Password"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Email"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Mobile"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Yes/No"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Created"></th>
                    <th><input type="text" class="form-control form-control-sm column-search" placeholder="Search Modified"></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>
                        <td>@dr["UserName"]</td>
                        <td>@dr["Password"]</td>
                        <td>@dr["Email"]</td>
                        <td>@dr["MobileNo"]</td>
                        <td class="text-center">
                            @if (Convert.ToBoolean(dr["IsActive"]))
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>@Convert.ToDateTime(dr["Created"]).ToString("yyyy-MM-dd")</td>
                        <td>@Convert.ToDateTime(dr["Modified"]).ToString("yyyy-MM-dd")</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <!-- ✅ Changed to use encoded key -->
                                <a href="@Url.Action("UserAddEdit", "User", new { key = IdEncoder.Encode(Convert.ToInt32(dr["UserID"])) })"
                                   class="btn btn-sm btn-primary" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <!-- Delete stays the same -->
                                <a asp-controller="User" asp-action="UserDelete" asp-route-ID="@dr["UserID"]"
                                   class="btn btn-sm btn-danger" title="Delete"
                                   onclick="return confirm('Are you sure you want to delete this record?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                <!-- Hidden Row for No Record -->
                <tr id="noRecord" style="display: none;">
                    <td colspan="8" class="text-center text-danger fw-bold">No Record Found!!</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Per-Column Search Script -->
<script>
    document.querySelectorAll(".column-search").forEach((input, colIndex) => {
        input.addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#userTable tbody tr");
            let matchFound = false;

            rows.forEach(row => {
                if (row.id === "noRecord") return;

                let cell = row.cells[colIndex];
                if (!cell) return;

                let text = cell.innerText.toLowerCase();
                let isMatch = text.includes(filter);

                if (filter === "") {
                    row.dataset["col" + colIndex] = "true";
                } else {
                    row.dataset["col" + colIndex] = isMatch;
                }

                // Check all filters for this row
                let visible = true;
                for (let i = 0; i < row.cells.length - 1; i++) {
                    if (row.dataset["col" + i] === "false") {
                        visible = false;
                        break;
                    }
                }

                row.style.display = visible ? "" : "none";
                if (visible) matchFound = true;
            });

            document.getElementById("noRecord").style.display = matchFound ? "none" : "";
        });
    });
</script>



























@* @model Hospital_Management_System.Models.DashboardViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-50: #eff6ff;
        --primary-100: #dbeafe;
        --primary-200: #bfdbfe;
        --primary-300: #93c5fd;
        --primary-400: #60a5fa;
        --primary-500: #3b82f6;
        --primary-600: #2563eb;
        --primary-700: #1d4ed8;
        --primary-800: #1e40af;
        --primary-900: #1e3a8a;
        --success-color: #059669;
        --danger-color: #dc2626;
        --warning-color: #d97706;
        --info-color: #0891b2;
        --secondary-color: #6b7280;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --gray-900: #0f172a;
        --white: #ffffff;
        --shadow-sm: 0 1px 2px 0 rgba(59, 130, 246, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(59, 130, 246, 0.1), 0 2px 4px -1px rgba(59, 130, 246, 0.06);
        --shadow-lg: 0 10px 15px -3px rgba(59, 130, 246, 0.1), 0 4px 6px -2px rgba(59, 130, 246, 0.05);
        --gradient-primary: linear-gradient(135deg, var(--primary-600) 0%, var(--primary-700) 100%);
        --gradient-success: linear-gradient(135deg, #059669 0%, #047857 100%);
        --gradient-warning: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        --gradient-info: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
        --gradient-secondary: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        --gradient-danger: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    }

    * {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
        background: linear-gradient(135deg, var(--primary-50) 0%, var(--primary-100) 100%);
        color: var(--gray-800);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0.75rem;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .dashboard-header {
        text-align: center;
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        background: var(--white);
        border-radius: 10px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--primary-200);
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .dashboard-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--gradient-primary);
        }

    .dashboard-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-700);
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .dashboard-subtitle {
        font-size: 0.75rem;
        color: var(--gray-600);
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .hospital-icon {
        font-size: 1.5rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .quick-stats {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
    }

    .quick-stat {
        text-align: center;
        padding: 0.375rem 0.5rem;
        background: var(--primary-50);
        border-radius: 6px;
        border: 1px solid var(--primary-200);
        min-width: 70px;
    }

    .quick-stat-number {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--primary-600);
        margin-bottom: 0.125rem;
    }

    .quick-stat-label {
        font-size: 0.6rem;
        color: var(--gray-600);
        font-weight: 500;
    }

    .cards-container {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 0.75rem;
        width: 100%;
        max-width: 1300px;
        height: 100%;
        max-height: 400px;
    }

    .dashboard-card {
        background: var(--white);
        border-radius: 10px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--primary-200);
        overflow: hidden;
        transition: all 0.3s ease;
        position: relative;
        min-height: 150px;
        display: flex;
        flex-direction: column;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .dashboard-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            transition: all 0.3s ease;
        }

        .dashboard-card.users::before {
            background: var(--gradient-primary);
        }

        .dashboard-card.doctors::before {
            background: var(--gradient-success);
        }

        .dashboard-card.departments::before {
            background: var(--gradient-info);
        }

        .dashboard-card.mappings::before {
            background: var(--gradient-secondary);
        }

        .dashboard-card.patients::before {
            background: var(--gradient-warning);
        }

        .dashboard-card.appointments::before {
            background: var(--gradient-danger);
        }

    .card-content {
        padding: 0.75rem;
        text-align: center;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-header-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.375rem;
    }

    .card-icon {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--white);
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .card-icon::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.2);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

    .dashboard-card:hover .card-icon::before {
        opacity: 1;
    }

    .users .card-icon {
        background: var(--gradient-primary);
    }

    .doctors .card-icon {
        background: var(--gradient-success);
    }

    .departments .card-icon {
        background: var(--gradient-info);
    }

    .mappings .card-icon {
        background: var(--gradient-secondary);
    }

    .patients .card-icon {
        background: var(--gradient-warning);
    }

    .appointments .card-icon {
        background: var(--gradient-danger);
    }

    .card-info {
        flex-grow: 1;
    }

    .card-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.125rem;
        line-height: 1.2;
    }

    .card-count {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
        display: block;
        line-height: 1;
    }

    .users .card-count {
        color: var(--primary-600);
    }

    .doctors .card-count {
        color: var(--success-color);
    }

    .departments .card-count {
        color: var(--info-color);
    }

    .mappings .card-count {
        color: var(--secondary-color);
    }

    .patients .card-count {
        color: var(--warning-color);
    }

    .appointments .card-count {
        color: var(--danger-color);
    }

    .card-description {
        color: var(--gray-600);
        font-size: 0.65rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .card-actions {
        display: flex;
        gap: 0.25rem;
        justify-content: center;
        margin-top: auto;
    }

    .btn-modern {
        padding: 0.25rem 0.5rem;
        border-radius: 5px;
        font-weight: 600;
        font-size: 0.65rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
