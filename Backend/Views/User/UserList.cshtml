<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <i class="bi bi-hospital hospital-icon"></i>
            Hospital Management System
        </div>
        <div class="dashboard-subtitle">
            Comprehensive healthcare management solution
        </div>

        <!-- Quick Stats -->
        <div class="quick-stats">
            <div class="quick-stat">
                <div class="quick-stat-number">@(Model.TotalUsers + Model.TotalDoctors + Model.TotalPatients)</div>
                <div class="quick-stat-label">Total People</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-number">@Model.TotalDepartments</div>
                <div class="quick-stat-label">Departments</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-number">@Model.TotalAppointments</div>
                <div class="quick-stat-label">Appointments</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-number">@DateTime.Now.ToString("MMM")</div>
                <div class="quick-stat-label">Current Month</div>
            </div>
        </div>
    </div>

    <!-- Cards Container -->
    <div class="cards-container">
        <div class="cards-grid">
            <!-- Users Card -->
            <div class="dashboard-card users">
                <div class="card-content">
                    <div class="card-header-section">
                        <div class="card-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="card-info">
                            <div class="card-title">System Users</div>
                            <div class="card-count">@Model.TotalUsers</div>
                        </div>
                    </div>
                    <div class="card-description">
                        Manage system users
                    </div>
                    <div class="card-actions">
                        <a href="/User/UserList" class="btn-modern btn-view">
                            <i class="bi bi-eye"></i>
                            View
                        </a>
                        <a href="/User/UserAddEdit" class="btn-modern btn-add">
                            <i class="bi bi-plus-circle"></i>
                            Add
                        </a>
                    </div>
                </div>
            </div>

            <!-- Doctors Card -->
            <div class="dashboard-card doctors">
                <div class="card-content">
                    <div class="card-header-section">
                        <div class="card-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div class="card-info">
                            <div class="card-title">Medical Doctors</div>
                            <div class="card-count">@Model.TotalDoctors</div>
                        </div>
                    </div>
                    <div class="card-description">
                        Manage doctor profiles
                    </div>
                    <div class="card-actions">
                        <a href="/Doctor/DoctorList" class="btn-modern btn-view">
                            <i class="bi bi-eye"></i>
                            View
                        </a>
                        <a href="/Doctor/DoctorAddEdit" class="btn-modern btn-add">
                            <i class="bi bi-plus-circle"></i>
                            Add
                        </a>
                    </div>
                </div>
            </div>

            <!-- Departments Card -->
            <div class="dashboard-card departments">
                <div class="card-content">
                    <div class="card-header-section">
                        <div class="card-icon">
                            <i class="bi bi-building-fill"></i>
                        </div>
                        <div class="card-info">
                            <div class="card-title">Departments</div>
                            <div class="card-count">@Model.TotalDepartments</div>
                        </div>
                    </div>
                    <div class="card-description">
                        Hospital departments
                    </div>
                    <div class="card-actions">
                        <a href="/Department/DepartmentList" class="btn-modern btn-view">
                            <i class="bi bi-eye"></i>
                            View
                        </a>
                        <a href="/Department/DepartmentAddEdit" class="btn-modern btn-add">
                            <i class="bi bi-plus-circle"></i>
                            Add
                        </a>
                    </div>
                </div>
            </div>

            <!-- Doctor-Department Mapping Card -->
            <div class="dashboard-card mappings">
                <div class="card-content">
                    <div class="card-header-section">
                        <div class="card-icon">
                            <i class="bi bi-diagram-3-fill"></i>
                        </div>
                        <div class="card-info">
                            <div class="card-title">Doctor-Department</div>
                            <div class="card-count">@Model.TotalDoctorDepartments</div>
                        </div>
                    </div>
                    <div class="card-description">
                        Map doctors to departments
                    </div>
                    <div class="card-actions">
                        <a href="/DoctorDepartment/DoctorDepartmentList" class="btn-modern btn-view">
                            <i class="bi bi-eye"></i>
