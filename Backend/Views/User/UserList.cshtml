                <tr>
                    <th>Username</th>
                    <th>Password</th>
                    <th>Email</th>
                    <th>Mobile No</th>
                    <th>Is Active</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>
                        <td>@dr["UserName"]</td>
                        <td>@dr["Password"]</td>
                        <td>@dr["Email"]</td>
