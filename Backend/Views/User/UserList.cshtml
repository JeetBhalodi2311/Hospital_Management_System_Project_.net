                        </a>
                        <a href="/Patient/PatientAddEdit" class="btn-modern btn-add">
                            <i class="bi bi-plus-circle"></i>
                            Add
                        </a>
                    </div>
                </div>
            </div>

            <!-- Appointments Card -->
            <div class="dashboard-card appointments">
                <div class="card-content">
                    <div class="card-header-section">
                        <div class="card-icon">
