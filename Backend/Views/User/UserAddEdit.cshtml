    }

    .input-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-400);
        z-index: 2;
        pointer-events: none;
    }

    .form-actions {
        background: var(--white);
        padding: 1.5rem 2rem;
        border-top: 1px solid var(--primary-100);
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    }
</style>

<div class="main-container">
    <!-- Header Section -->
    <div class="header-section">
        <div class="page-title">
            <div class="title-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            User Add/Edit
        </div>

        <nav class="breadcrumb-modern">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/Dashboard/Index">
                        <i class="bi bi-house-door me-1"></i>Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/User/UserList">User List</a>
                </li>
                <li class="breadcrumb-item active">User Add/Edit</li>
            </ol>
        </nav>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <!-- Alert Messages -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-modern alert-danger-modern">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span><strong>Error:</strong> @TempData["ErrorMessage"]</span>
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-modern alert-success-modern">
                <i class="bi bi-check-circle-fill"></i>
                <span><strong>Success:</strong> @TempData["SuccessMessage"]</span>
            </div>
        }

        <!-- Form Card -->
        <div class="form-card">
            <div class="form-header">
                <h5>
                    <i class="bi bi-pencil-square"></i>
                    Enter User Details
                </h5>
            </div>

            <form method="post" asp-controller="User" asp-action="UserAddEdit">
                <div class="form-body">
                    <input asp-for="UserID" type="hidden" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <label asp-for="UserName" class="form-label">
                                    <i class="bi bi-person"></i>
                                    Username
                                </label>
                                <input asp-for="UserName" type="text" name="UserName" class="form-control form-control-modern" placeholder="Enter username" />
                                <i class="bi bi-person-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <label asp-for="Password" class="form-label">
                                    <i class="bi bi-shield-lock"></i>
                                    Password
                                </label>
                                <input asp-for="Password" type="password" name="Password" class="form-control form-control-modern" placeholder="Enter password" />
                                <i class="bi bi-lock-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <label asp-for="Email" class="form-label">
                                    <i class="bi bi-envelope"></i>
                                    Email Address
                                </label>
                                <input asp-for="Email" type="email" name="Email" class="form-control form-control-modern" placeholder="Enter email address" />
                                <i class="bi bi-envelope-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <label asp-for="MobileNo" class="form-label">
                                    <i class="bi bi-phone"></i>
                                    Mobile Number
                                </label>
                                <input asp-for="MobileNo" type="text" name="MobileNo" class="form-control form-control-modern" placeholder="Enter mobile number" />
                                <i class="bi bi-phone-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                <i class="bi bi-toggle-on"></i>
                                User Status
                            </label>
                            <div class="checkbox-container">
                                <div class="checkbox-wrapper">
                                    <input asp-for="IsActive" type="checkbox" class="checkbox-modern" id="isActiveCheck" />
                                    <label for="isActiveCheck" class="checkbox-label">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Is Active - User can login and access the system
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/User/UserList" class="btn-modern btn-secondary-modern">
                        <i class="bi bi-arrow-left"></i>
                        Cancel
                    </a>
                    <button type="submit" class="btn-modern btn-primary-modern">
                        <i class="bi bi-save2"></i>
                        Save User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Add entrance animations
    window.addEventListener('load', function() {
        const formCard = document.querySelector('.form-card');
        formCard.style.opacity = '0';
        formCard.style.transform = 'translateY(20px)';

        setTimeout(() => {
            formCard.style.transition = 'all 0.6s ease';
            formCard.style.opacity = '1';
            formCard.style.transform = 'translateY(0)';
        }, 100);
    });

    // Enhanced form interactions
    const inputs = document.querySelectorAll('.form-control-modern');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.parentElement.style.transform = 'scale(1.02)';
        });

        input.addEventListener('blur', function() {
            this.parentElement.style.transform = 'scale(1)';
        });
    });
</script> *@
