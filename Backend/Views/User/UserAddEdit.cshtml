        .checkbox-modern:checked {
            background: var(--primary-600);
            border-color: var(--primary-600);
        }

    .checkbox-label {
        color: var(--gray-700);
        font-weight: 500;
        cursor: pointer;
        user-select: none;
    }

    .btn-modern {
