            }

        .breadcrumb-modern .active {
            color: var(--white);
            font-weight: 600;
        }

    .form-container {
        padding: 2rem 2.5rem;
        background: var(--white);
    }

    .form-card {
        background: var(--white);
        border-radius: 16px;
        border: 1px solid var(--primary-200);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .form-header {
        background: linear-gradient(135deg, var(--primary-600) 0%, var(--primary-700) 100%);
        padding: 1.5rem 2rem;
        color: var(--white);
        border-bottom: none;
    }

