<script>

    document.getElementById("searchInput").addEventListener("keyup", function () {
        let input = this.value.toLowerCase();
            let rows = document.querySelectorAll("#appointmentTable tbody tr");


        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    });

    document.querySelectorAll(".filter-input").forEach((input, colIndex) => {
        input.addEventListener("input", function () {
            let filterValue = this.value.toLowerCase();
            let rows = document.querySelectorAll("#appointmentTable tbody tr");

            rows.forEach(row => {
                let cell = row.cells[colIndex];
                if (cell) {
                    let text = cell.innerText.toLowerCase();
                    let match = text.includes(filterValue) || filterValue === "";

                    // For Date and Amount (exact match csheck)
                    if (this.type === "date" || this.type === "number") {
                        match = text.startsWith(filterValue) || filterValue === "";
                    }

                    // Hide row if this column doesn't match
                    if (!match) {
                        row.style.display = "none";
                    } else {
                        // Check if all filters match
                        let allMatch = true;
                        document.querySelectorAll(".filter-input").forEach((fInput, fIndex) => {
                            let fValue = fInput.value.toLowerCase();
                            let fCell = row.cells[fIndex];
                            if (fCell) {
                                let fText = fCell.innerText.toLowerCase();
                                if (fInput.type === "date" || fInput.type === "number") {
                                    if (fValue && !fText.startsWith(fValue)) allMatch = false;
                                } else {
                                    if (fValue && !fText.includes(fValue)) allMatch = false;
                                }
                            }
                        });
                        row.style.display = allMatch ? "" : "none";
                    }
                }
            });
        });
    });

</script>

