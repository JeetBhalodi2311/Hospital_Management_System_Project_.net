<div class="table-responsive shadow-sm rounded" style="max-height: 70vh; overflow-y: auto;">
    <table id="appointmentTable" class="table table-hover table-bordered align-middle">

        <thead class="table-primary text-center">
            <tr>
                <th>Appointment ID</th>
                <th>Doctor</th>
                <th>Patient</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Description</th>
                <th>Special Remarks</th>
                <th>Created</th>
                <th>Modified</th>
                <th>Total Amount</th>
                <th>Actions</th>
            </tr>

            <!-- 🔍 Filters Row -->
            <tr class="bg-light">
                <th><input type="text" class="form-control form-control-sm filter-input" placeholder="ID" /></th>
                <th><input type="text" class="form-control form-control-sm filter-input" placeholder="Doctor" /></th>
                <th><input type="text" class="form-control form-control-sm filter-input" placeholder="Patient" /></th>
                <th><input type="date" class="form-control form-control-sm filter-input" /></th>
                <th>
                    <select class="form-select form-select-sm filter-input">
                        <option value="">All</option>
                        <option value="Pending">Pending</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </th>
                <th><input type="text" class="form-control form-control-sm filter-input" placeholder="Description" /></th>
                <th><input type="text" class="form-control form-control-sm filter-input" placeholder="Remarks" /></th>
                <th><input type="date" class="form-control form-control-sm filter-input" /></th>
                <th><input type="date" class="form-control form-control-sm filter-input" /></th>
                <th><input type="number" class="form-control form-control-sm filter-input" placeholder="Amount" /></th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (DataRow appt in Model.Rows)
            {
                var status = appt["AppointmentStatus"].ToString();
                var badgeClass = $"status-badge status-{status}";

                <tr>
                    <td class="text-center">@appt["AppointmentID"]</td>
                    <td>@appt["Dname"]</td>
                    <td>@appt["Pname"]</td>
                    @* <td>@Convert.ToDateTime(appt["AppointmentDate"]).ToString("yyyy-MM-dd HH:mm")</td> *@
                    <td data-date='@Convert.ToDateTime(appt["AppointmentDate"]).ToString("s")'>
                        @Convert.ToDateTime(appt["AppointmentDate"]).ToString("yyyy-MM-dd HH:mm")
                    </td>

                    <td><span class="@badgeClass">@status</span></td>
                    <td>@appt["Description"]</td>
                    <td>@appt["SpecialRemarks"]</td>
                    <td>@Convert.ToDateTime(appt["Created"]).ToString("yyyy-MM-dd")</td>
                    <td>@Convert.ToDateTime(appt["Modified"]).ToString("yyyy-MM-dd")</td>
                    <td class="text-end">₹@appt["TotalConsultedAmount"]</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="@Url.Action("AppointmentAddEdit", "Appointment", new { AppointmentID = appt["AppointmentID"] })" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-controller="Appointment" asp-action="AppointmentDelete" asp-route-ID="@appt["AppointmentID"]" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this record?');">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</div>


