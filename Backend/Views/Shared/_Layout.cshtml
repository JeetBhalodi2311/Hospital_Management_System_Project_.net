                <ul id="employee-nav" class="nav-content collapse" data-bs-parent="#sidebar-nav">
                    <li><a asp-controller="Employee" asp-action="EmployeeList"><i class="bi bi-circle"></i><span>Employee List</span></a></li>
                    <li><a asp-controller="Employee" asp-action="EmployeeAddEdit"><i class="bi bi-circle"></i><span>Employee Add</span></a></li>
