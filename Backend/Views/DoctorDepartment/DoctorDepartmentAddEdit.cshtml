@model Hospital_Management_System.Models.DoctorDepartmentModel

<!-- Breadcrumb and Title Section -->
<div class="container mt-4">
    <h4 class="fw-bold text-primary"><i class="bi bi-diagram-3-fill me-2"></i>Doctor Department Add/Edit</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light px-3 py-2 rounded shadow-sm">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none text-dark">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/DoctorDepartment/DoctorDepartmentList" class="text-decoration-none text-dark">Doctor Department List</a></li>
            <li class="breadcrumb-item active text-primary" aria-current="page">Doctor Department Add/Edit</li>
        </ol>
    </nav>
</div>

<!-- Form Section -->
<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Map Doctor with Department</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row g-3">

                    <div class="form-group">
                        <label>Doctor</label>
                        <select asp-for="DoctorID" class="form-control"
                                asp-items="@(new SelectList(ViewBag.DoctorList, "DoctorID", "Name"))">
                            <option value="">-- Select Doctor --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Department</label>
                        <select asp-for="DepartmentID" class="form-control"
                                asp-items="@(new SelectList(ViewBag.DepartmentList, "DepartmentID", "DepartmentName"))">
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>

                    @* <div class="col-md-6">
                        <label asp-for="DepartmentID" class="form-label fw-semibold">Department ID</label>
                        <input asp-for="DepartmentID" type="number" name="DepartmentID" class="form-control" placeholder="Enter Department ID" required />
                    </div> *@

                    <div class="form-group">
                        <label asp-for="UserID"></label>
                        <select asp-for="UserID" asp-items="@(new SelectList(ViewBag.UserList, "UserID", "UserName"))" class="form-control">
                            <option value="">-- Select User --</option>
                        </select>
                        <span asp-validation-for="UserID" class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Save Mapping
                    </button>
                    <a href="/DoctorDepartment/DoctorDepartmentList" class="btn btn-secondary ms-2 px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
