@model RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register - HMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Background layer */
        .bg-image {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('/assets/img/bg3.jpg') no-repeat center center fixed;
            background-size: cover;
            filter: blur(8px);
            z-index: -1;
        }

        .card {
            background: rgba(255, 255, 255, 0.85); 
            border-radius: 15px;
            backdrop-filter: blur(4px);
        }
    </style>
</head>
<body>
    <!-- ✅ Blurred background -->
    <div class="bg-image"></div>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-lg p-4" style="width: 100%; max-width: 500px;">
            <h3 class="text-center text-success mb-3">Hospital Management System</h3>
            <h4 class="text-center mb-4">Create an Account</h4>

            <!-- ✅ Show TempData success message if available -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Register" method="post" novalidate>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="Doctor">Doctor</option>
                        <option value="Patient">Patient</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Register</button>
                <div class="text-center mt-3">
                    <a href="/Account/Login" class="text-decoration-none">Already registered? Login</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


@* @model RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - HealthCare Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-container {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.1);
        }

        .brand-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            }

        .form-select {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

        .btn-register {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(40, 167, 69, 0.3);
            }

        .input-group-text {
            border: 2px solid #e9ecef;
            border-right: none;
            border-radius: 12px 0 0 12px;
            background: #f8f9fa;
        }

        .form-control-icon {
            border-left: none;
            border-radius: 0 12px 12px 0;
        }

        .footer-links {
            border-top: 1px solid #e9ecef;
            padding-top: 1.5rem;
            margin-top: 1.5rem;
        }

        .company-info {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .role-card {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .role-card:hover {
                border-color: #667eea;
                background: #f8f9ff;
            }

            .role-card.selected {
                border-color: #667eea;
                background: #f8f9ff;
            }

        @@media (max-width: 768px) {
            .register-container

        {
            margin: 1rem;
        }

        .company-info {
            display: none;
        }

        }

        .progress-step {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

            .progress-step.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
            }

        .progress-line {
            height: 2px;
            background: #e9ecef;
            flex: 1;
            margin: 0 1rem;
        }

            .progress-line.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="row">
                    <!-- Company Information Side -->
                    <div class="col-lg-5 d-none d-lg-block">
                        <div class="company-info h-100 d-flex flex-column justify-content-center">
                            <div class="text-center mb-4">
                                <div class="brand-logo mx-auto mb-3">
                                    <i class="bi bi-hospital text-white" style="font-size: 2.5rem;"></i>
                                </div>
                                <h2 class="text-dark fw-bold">HealthCare Pro</h2>
                                <p class="text-muted fs-5">Join Our Healthcare Network</p>
                            </div>

                            <!-- Registration Benefits -->
                            <div class="mb-4">
                                <h5 class="fw-semibold mb-3">Why Join Us?</h5>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="p-2 bg-primary bg-opacity-10 rounded-circle me-3">
                                        <i class="bi bi-check-circle text-primary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Comprehensive Care</h6>
                                        <small class="text-muted">Complete healthcare management</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="p-2 bg-success bg-opacity-10 rounded-circle me-3">
                                        <i class="bi bi-people text-success"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Expert Network</h6>
                                        <small class="text-muted">Connect with healthcare professionals</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="p-2 bg-info bg-opacity-10 rounded-circle me-3">
                                        <i class="bi bi-clock text-info"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">24/7 Access</h6>
                                        <small class="text-muted">Round-the-clock healthcare services</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Trust Indicators -->
                            <div class="text-center">
                                <div class="row">
                                    <div class="col-4">
                                        <h4 class="text-primary fw-bold mb-0">10K+</h4>
                                        <small class="text-muted">Patients</small>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-success fw-bold mb-0">500+</h4>
                                        <small class="text-muted">Doctors</small>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-info fw-bold mb-0">50+</h4>
                                        <small class="text-muted">Hospitals</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Registration Form Side -->
                    <div class="col-lg-7">
                        <div class="register-container rounded-4 p-4 p-lg-5">
                            <!-- Mobile Logo -->
                            <div class="d-lg-none text-center mb-4">
                                <div class="brand-logo">
                                    <i class="bi bi-hospital text-white" style="font-size: 2rem;"></i>
                                </div>
                                <h4 class="fw-bold text-dark">HealthCare Pro</h4>
                            </div>

                            <!-- Progress Indicator -->
                            <div class="d-flex align-items-center justify-content-center mb-4">
                                <div class="progress-step active">1</div>
                                <div class="progress-line"></div>
                                <div class="progress-step">2</div>
                                <div class="progress-line"></div>
                                <div class="progress-step">3</div>
                            </div>

                            <div class="text-center mb-4">
                                <h3 class="fw-bold text-dark">Create Your Account</h3>
                                <p class="text-muted">Join thousands of healthcare professionals and patients</p>
                            </div>

                            @if (ViewBag.ErrorMessage != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    @ViewBag.ErrorMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form asp-action="Register" method="post" novalidate>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold text-dark">Full Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-person"></i>
                                            </span>
                                            <input asp-for="FullName" type="text" class="form-control form-control-icon"
                                                   placeholder="Enter your full name" />
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold text-dark">Email Address</label>
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="bi bi-envelope"></i>
                                            </span>
                                            <input asp-for="Email" type="email" class="form-control form-control-icon"
                                                   placeholder="Enter your email" />
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-lock"></i>
                                        </span>
                                        <input asp-for="Password" type="password" class="form-control form-control-icon"
                                               placeholder="Create a strong password" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                    <div class="form-text">
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Password must be at least 8 characters with uppercase, lowercase, and numbers
                                        </small>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-dark">Select Your Role</label>
                                    <select asp-for="Role" class="form-select" style="display: none;">
                                        <option value="">-- Select Role --</option>
                                        <option value="Admin">Admin</option>
                                        <option value="Doctor">Doctor</option>
                                        <option value="Patient">Patient</option>
                                    </select>

                                    <!-- Custom Role Selection -->
                                    <div class="role-selection mt-2">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="role-card text-center" data-role="Patient">
                                                    <i class="bi bi-person-heart text-primary fs-2 mb-2"></i>
                                                    <h6 class="fw-semibold">Patient</h6>
                                                    <small class="text-muted">Access medical records & appointments</small>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="role-card text-center" data-role="Doctor">
                                                    <i class="bi bi-person-badge text-success fs-2 mb-2"></i>
                                                    <h6 class="fw-semibold">Doctor</h6>
                                                    <small class="text-muted">Manage patients & medical records</small>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="role-card text-center" data-role="Admin">
                                                    <i class="bi bi-gear text-warning fs-2 mb-2"></i>
                                                    <h6 class="fw-semibold">Admin</h6>
                                                    <small class="text-muted">System administration & oversight</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Role" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="terms" required>
                                        <label class="form-check-label text-muted" for="terms">
                                            I agree to the <a href="#" class="text-decoration-none">Terms of Service</a>
                                            and <a href="#" class="text-decoration-none">Privacy Policy</a>
                                        </label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-register text-white w-100 mb-3">
                                    <i class="bi bi-person-plus me-2"></i>
                                    Create Account
                                </button>
                            </form>

                            <div class="footer-links text-center">
                                <p class="text-muted mb-2">Already have an account?</p>
                                <a href="/Account/Login" class="btn btn-outline-primary rounded-pill px-4">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Sign In
                                </a>

                                <div class="mt-4 pt-3 border-top">
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <small class="text-muted">
                                                <i class="bi bi-shield-lock me-1"></i>
                                                Secure Registration
                                            </small>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                Instant Approval
                                            </small>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted">
                                                <i class="bi bi-headset me-1"></i>
                                                24/7 Support
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Custom role selection functionality
        document.addEventListener('DOMContentLoaded', function() {
            const roleCards = document.querySelectorAll('.role-card');
            const roleSelect = document.querySelector('select[name="Role"]');

            roleCards.forEach(card => {
                card.addEventListener('click', function() {
                    // Remove selected class from all cards
                    roleCards.forEach(c => c.classList.remove('selected'));

                    // Add selected class to clicked card
                    this.classList.add('selected');

                    // Update the hidden select value
                    const role = this.getAttribute('data-role');
                    roleSelect.value = role;

                    // Trigger change event for validation
                    roleSelect.dispatchEvent(new Event('change'));
                });
            });

            // Set initial selection if role is already selected
            if (roleSelect.value) {
                const selectedCard = document.querySelector(`[data-role="${roleSelect.value}"]`);
                if (selectedCard) {
                    selectedCard.classList.add('selected');
                }
            }
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html> *@
