@model Hospital_Management_System.Models.ImageModel
@{
    ViewData["Title"] = "Image Add/Edit";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <!-- Card for Form -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-top-4">
                    <h4 class="mb-0"><i class="bi bi-image me-2"></i> Image Add/Edit</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data" asp-controller="Image" asp-action="ImageAddEdit">
                        <!-- Image Name -->
                        <div class="mb-3">
                            <label for="ImageName" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-2"></i> Image Name
                            </label>
                            <input type="text" name="ImageName" id="ImageName" class="form-control form-control-lg" placeholder="Enter image name" required />
                        </div>

                        <!-- Upload File -->
                        <div class="mb-3">
                            <label for="Image" class="form-label fw-semibold">
                                <i class="bi bi-upload me-2"></i> Profile Picture
                            </label>
                            <input type="file" name="Image" id="Image" class="form-control form-control-lg" />
                            <div class="form-text">Allowed formats: JPG, PNG (Max 2MB)</div>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-2"></i> Submit
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Uploaded Details -->
            @if (ViewBag.ImageName != null)
            {
                <div class="card shadow-lg border-0 rounded-4 mt-4">
                    <div class="card-header bg-dark text-white rounded-top-4">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Uploaded Details</h5>
                    </div>
                    <div class="card-body p-4">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Image Name</th>
                                    <th>Preview</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-semibold">@ViewBag.ImageName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(ViewBag.ImagePath))
                                        {
                                            <div class="text-center">
                                                <img src="~/@ViewBag.ImagePath"
                                                     alt="User Image"
                                                     class="img-fluid rounded shadow"
                                                     style="max-width:250px; border:4px solid #198754;" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image uploaded</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
